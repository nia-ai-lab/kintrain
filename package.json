{
  "name": "kintrain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run frontend:dev:with-dev-backend",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:dev:with-dev-backend": "npm run sync:branch-outputs && npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "backend:typecheck": "tsc -p tsconfig.backend.json --noEmit",
    "sync:branch-outputs": "./scripts/sync-branch-outputs.sh",
    "migrate:menu-sets": "node scripts/migrate-training-menu-sets.mjs",
    "migrate:menu-description": "node scripts/migrate-training-menu-description.mjs",
    "migrate:menu-prescriptions": "node scripts/migrate-training-menu-prescriptions.mjs",
    "migrate:muscle-targets": "tsx scripts/migrate-muscle-targets.ts",
    "test:api-ui-spec": "node tests/api-ui-spec.e2e.mjs",
    "build": "npm run frontend:build",
    "amplify:sandbox": "npx ampx sandbox",
    "amplify:pipeline-deploy": "npx ampx pipeline-deploy",
    "test:mcp": "tsx --test tests/mcp-*.test.ts",
    "test:mcp-identity": "tsx --test tests/mcp-identity-interceptor.test.ts",
    "test:coaching-context": "tsx --test tests/coaching-context.test.ts",
    "test:training-priority": "tsx --test tests/training-priority.test.ts",
    "test:ui-spec": "playwright test -c playwright.config.mjs"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.18.1",
    "@aws-amplify/backend-cli": "^1.8.2",
    "@playwright/test": "^1.58.2",
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^25.3.2",
    "aws-cdk-lib": "^2.263.0",
    "constructs": "^10.4.2",
    "tsx": "^4.23.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.840.0",
    "@aws-sdk/client-dynamodb": "^3.840.0",
    "@aws-sdk/client-s3": "^3.1001.0",
    "@aws-sdk/client-secrets-manager": "3.1000.0",
    "@aws-sdk/lib-dynamodb": "^3.840.0",
    "@aws-sdk/s3-presigned-post": "^3.1001.0",
    "@aws-sdk/s3-request-presigner": "^3.1001.0",
    "amazon-cognito-identity-js": "^6.3.16",
    "aws-jwt-verify": "^5.2.1"
  }
}
