  {
    "name": "reschedule_temporary_training_plan",
    "description": "既存の一時メニューセットID、種目構成、処方を維持したまま有効期間と完全休息日を変更する。最初にdryRun=trueで差分を確認する。競合置換にはユーザーの明示確認が必要。",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trainingMenuSetId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "newValidFromDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "newValidToDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "restDates": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "description": "新しい有効期間内の完全休息日。省略時は新しい期間にも含まれる既存休息日だけを保持する。"
        },
        "expectedVersion": { "type": "integer", "minimum": 0 },
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 100 },
        "conflictPolicy": {
          "type": "string",
          "enum": ["reject", "replace"],
          "description": "既定はreject。replaceは競合セット全体を安全に置換できる場合だけ許可される。"
        },
        "dryRun": { "type": "boolean", "description": "trueなら検証と差分表示だけを行う。" },
        "updateReason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "userConfirmed": {
          "type": "boolean",
          "enum": [true],
          "description": "競合置換についてユーザーが明示的に承認した場合だけtrue。"
        }
      },
