  {
    "name": "update_temporary_training_menu_set",
    "description": "既存の一時メニューセットを部分更新する。未指定項目は保持し、itemAddsは登録済み種目マスタだけを参照する。日付だけの変更にはreschedule_temporary_training_planを優先する。",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trainingMenuSetId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "expectedVersion": { "type": "integer", "minimum": 0 },
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 100 },
        "setName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "validFromDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "validToDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "conflictPolicy": { "type": "string", "enum": ["reject", "replace"] },
        "userConfirmed": { "type": "boolean", "enum": [true] },
        "itemUpdates": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "trainingMenuSetItemId": { "type": "string", "minLength": 1, "maxLength": 100 },
              "targetWeightKg": { "type": "number", "minimum": 0, "maximum": 1000 },
              "targetRepsMin": { "type": "integer", "minimum": 1, "maximum": 1000 },
              "targetRepsMax": { "type": "integer", "minimum": 1, "maximum": 1000 },
              "targetSets": { "type": "integer", "minimum": 1, "maximum": 100 },
              "recommendedIntervalDays": { "type": "integer", "minimum": 1, "maximum": 8 },
              "instruction": { "type": "string", "maxLength": 500 }
            },
            "required": ["trainingMenuSetItemId"]
          }
        },
        "itemAdds": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "trainingMenuItemId": { "type": "string", "minLength": 1, "maxLength": 100 },
              "prescription": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "targetWeightKg": { "type": "number", "minimum": 0, "maximum": 1000 },
                  "targetRepsMin": { "type": "integer", "minimum": 1, "maximum": 1000 },
                  "targetRepsMax": { "type": "integer", "minimum": 1, "maximum": 1000 },
                  "targetSets": { "type": "integer", "minimum": 1, "maximum": 100 },
                  "recommendedIntervalDays": { "type": "integer", "minimum": 1, "maximum": 8 },
                  "instruction": { "type": "string", "maxLength": 500 }
                },
                "required": [
                  "targetWeightKg",
                  "targetRepsMin",
                  "targetRepsMax",
                  "targetSets",
                  "recommendedIntervalDays"
                ]
              }
            },
            "required": ["trainingMenuItemId", "prescription"]
          }
        },
        "itemRemovals": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "itemOrder": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "dryRun": { "type": "boolean" },
        "updateReason": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "required": ["trainingMenuSetId", "expectedVersion", "idempotencyKey"]
    }
  },
  {
    "name": "create_temporary_training_menu_set_from_ai",
    "description": "既存種目と新規種目を組み合わせたAI作成の一時メニューセットを、有効開始日・終了日付きで登録する。期間内は1日につき1つの一時メニューを割り当てる。",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "同じ登録要求の重複作成を防ぐ一意なキー"
        },
        "validFromDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "有効開始日（ユーザーのローカル日付、開始日を含む）"
        },
        "validToDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "有効終了日（ユーザーのローカル日付、終了日を含む。開始日から31日以内）"
        },
        "setName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "一時メニューセット名"
        },
        "replaceExistingPlan": {
          "type": "boolean",
          "description": "期間内に既存の一時メニューがある場合、ユーザー確認後に置き換えるか"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "existingTrainingMenuItemId": {
                "type": "string",
                "description": "既存種目を利用する場合の種目ID"
              },
              "newTrainingMenuItem": {
                "type": "object",
                "description": "新規種目を作成する場合の種目マスタ定義",
                "additionalProperties": false,
                "properties": {
                  "trainingName": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "bodyPart": { "type": "string", "maxLength": 100 },
                  "equipment": {
                    "type": "string",
                    "enum": ["マシン", "フリー", "自重", "その他"]
                  },
                  "description": { "type": "string", "maxLength": 500 },
                  "weightInputMode": {
                    "type": "string",
                    "enum": ["direct", "perSide"]
                  },
                  "fixedWeightKg": { "type": "number", "minimum": 0 }
                },
                "required": ["trainingName", "equipment"]
              },
              "prescription": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "targetWeightKg": { "type": "number", "minimum": 0, "maximum": 1000 },
                  "targetRepsMin": { "type": "integer", "minimum": 1, "maximum": 1000 },
                  "targetRepsMax": { "type": "integer", "minimum": 1, "maximum": 1000 },
                  "targetSets": { "type": "integer", "minimum": 1, "maximum": 100 },
                  "recommendedIntervalDays": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8
                  },
                  "instruction": { "type": "string", "maxLength": 500 }
                },
                "required": [
                  "targetWeightKg",
                  "targetRepsMin",
                  "targetRepsMax",
                  "targetSets",
                  "recommendedIntervalDays"
                ]
              }
            },
            "required": ["prescription"]
          }
        }
      },
      "required": ["idempotencyKey", "validFromDate", "validToDate", "setName", "items"]
    }
  }
