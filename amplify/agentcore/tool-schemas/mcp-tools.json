    }
  },
  {
    "name": "update_temporary_training_menu_set",
    "description": "登録済みの一時メニューセットを部分更新する。未指定項目は保持し、itemAddsでは登録済み種目の参照または新規種目マスタの同時作成ができる。内容変更は最初にdryRun=trueで差分を確認し、ユーザーへ提示して明示承認を得た後だけuserConfirmed=trueで確定する。日付だけの変更にはreschedule_temporary_training_planを優先する。",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trainingMenuSetId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "expectedVersion": { "type": "integer", "minimum": 0 },
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 100 },
        "setName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "validFromDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "validToDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "conflictPolicy": { "type": "string", "enum": ["reject", "replace"] },
        "userConfirmed": {
          "type": "boolean",
          "enum": [true],
          "description": "dryRun結果を提示し、ユーザーが内容変更を明示承認した場合だけtrue。"
        },
        "itemUpdates": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "trainingMenuSetItemId": { "type": "string", "minLength": 1, "maxLength": 100 },
              "targetWeightKg": { "type": "number", "minimum": 0, "maximum": 1000 },
              "targetRepsMin": { "type": "integer", "minimum": 1, "maximum": 1000 },
              "targetRepsMax": { "type": "integer", "minimum": 1, "maximum": 1000 },
              "targetSets": { "type": "integer", "minimum": 1, "maximum": 100 },
              "recommendedIntervalDays": { "type": "integer", "minimum": 1, "maximum": 8 },
              "instruction": { "type": "string", "maxLength": 500 }
            },
            "required": ["trainingMenuSetItemId"]
          }
        },
