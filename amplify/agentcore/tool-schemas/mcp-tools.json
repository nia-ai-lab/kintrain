        "updateReason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "userConfirmed": {
          "type": "boolean",
          "enum": [true],
          "description": "競合置換についてユーザーが明示的に承認した場合だけtrue。"
        }
      },
      "required": [
