[
  {
    "name": "get_analysis_export_manifest",
    "description": "KinTrain分析用エクスポートの固定スキーマ、ユーザープロフィール、現在の目標、取得対象セクションを返す。全データを分析する場合は最初に呼び出し、その後get_analysis_export_pageを各セクションのnextTokenがnullになるまで呼び出す。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "rangeMode": {
          "type": "string",
          "enum": ["dateRange", "allAvailable"],
          "description": "dateRangeは指定期間、allAvailableは保存されている全期間を対象にする。"
        },
        "from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "rangeMode=dateRangeの開始ローカル日（YYYY-MM-DD、含む）。"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "rangeMode=dateRangeの終了ローカル日（YYYY-MM-DD、含む）。"
        },
        "timeZoneId": {
          "type": "string",
          "description": "日付の解釈に使うIANAタイムゾーンID。省略時はAsia/Tokyo。"
        }
      },
      "required": ["rangeMode"]
    }
  },
  {
    "name": "get_analysis_export_page",
    "description": "KinTrain分析用エクスポートをセクション別に最大50件ずつ返す。同じrangeMode、期間、timeZoneId、sectionを保ち、レスポンスのpage.nextTokenがnullになるまで繰り返し呼び出す。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "rangeMode": {
          "type": "string",
          "enum": ["dateRange", "allAvailable"],
          "description": "dateRangeは指定期間、allAvailableは保存されている全期間を対象にする。"
        },
        "from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "rangeMode=dateRangeの開始ローカル日（YYYY-MM-DD、含む）。"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "rangeMode=dateRangeの終了ローカル日（YYYY-MM-DD、含む）。"
        },
        "timeZoneId": {
          "type": "string",
          "description": "日付の解釈に使うIANAタイムゾーンID。manifestと同じ値を指定する。省略時はAsia/Tokyo。"
        },
        "section": {
          "type": "string",
          "enum": ["trainingMenus", "trainingMenuSets", "dailyRecords", "gymVisits"],
          "description": "取得するデータセクション。"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "1ページの最大取得件数（1-50、既定50）。"
        },
        "nextToken": {
          "type": "string",
          "description": "前回の同一セクション・同一期間レスポンスに含まれるpage.nextToken。最初の呼び出しでは指定しない。"
        }
      },
      "required": ["rangeMode", "section"]
    }
  },
  {
    "name": "get_gym_visits",
    "description": "ジム実施履歴をローカル日付範囲で取得する。nextTokenがなくなるまで呼び出すと全件取得できる。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "開始ローカル日（YYYY-MM-DD、含む）。未指定なら最古から取得する。"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "終了ローカル日（YYYY-MM-DD、含む）。未指定なら最新まで取得する。"
        },
        "timeZoneId": {
          "type": "string",
          "description": "日付境界に使うIANAタイムゾーンID。既定はAsia/Tokyo。"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "1ページの取得件数（1-100、既定100）"
        },
        "nextToken": {
          "type": "string",
          "description": "前回レスポンスのnextToken。続きがない場合は指定しない。"
        }
      }
    }
  },
  {
    "name": "get_training_history",
    "description": "特定トレーニングメニューの過去実施履歴を取得する。trainingMenuItemIdまたはtrainingMenuNameのどちらかを指定する。通常の会話では種目名をそのままtrainingMenuNameへ指定できる。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "trainingMenuItemId": {
          "type": "string",
          "description": "対象トレーニングメニューID。IDが既知の場合に指定する。"
        },
        "trainingMenuName": {
          "type": "string",
          "description": "対象トレーニング名。登録済みの名前と空白・英字大小を除いて完全一致させる。IDが不明な通常の会話ではこちらを指定する。"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "1ページの取得件数（1-100、既定100）"
        },
        "from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "開始ローカル日（YYYY-MM-DD、含む）。未指定なら最古から取得する。"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "終了ローカル日（YYYY-MM-DD、含む）。未指定なら最新まで取得する。"
        },
        "timeZoneId": {
          "type": "string",
          "description": "日付境界に使うIANAタイムゾーンID。既定はAsia/Tokyo。"
        },
        "nextToken": {
          "type": "string",
          "description": "前回レスポンスのnextToken。続きがない場合は指定しない。"
        }
      }
    }
  },
  {
    "name": "get_daily_records",
    "description": "期間または複数日分のDaily記録を取得する。1日だけを取得する場合はget_daily_recordを使用する。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "開始ローカル日（YYYY-MM-DD、含む）。未指定なら最古から取得する。"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "終了ローカル日（YYYY-MM-DD、含む）。未指定なら最新まで取得する。"
        },
        "timeZoneId": {
          "type": "string",
          "description": "日付境界を表すIANAタイムゾーンID。既定はAsia/Tokyo。"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "1ページの取得件数（1-100、既定100）"
        },
        "nextToken": {
          "type": "string",
          "description": "前回レスポンスのnextToken。続きがない場合は指定しない。"
        }
      }
    }
  },
  {
    "name": "get_daily_record",
    "description": "指定した1日だけのDaily記録を取得する。期間や複数日の取得にはget_daily_recordsを使用する。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "対象日（YYYY-MM-DD）"
        }
      },
      "required": ["date"]
    }
  },
  {
    "name": "save_daily_diary",
    "description": "Dailyの日記(diary)を保存する。既存日記がある場合はmode指定で追記または上書きする。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "diary": {
          "type": "string",
          "description": "保存する日記本文"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "対象日（YYYY-MM-DD）。未指定時はtimeZoneId基準の本日。"
        },
        "timeZoneId": {
          "type": "string",
          "description": "IANAタイムゾーンID。date未指定時の本日判定に使う。"
        },
        "mode": {
          "type": "string",
          "enum": ["append", "overwrite"],
          "description": "既存日記がある場合の保存モード。append または overwrite。"
        }
      },
      "required": ["diary"]
    }
  },
  {
    "name": "save_daily_meal_notes",
    "description": "Dailyの「食事内容・栄養メモ」(mealNotes)を自由記述で保存する。食事内容、量、時間、水分、サプリメントなどを記録できる。既存メモがある場合はmode指定で追記または上書きする。",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mealNotes": {
          "type": "string",
          "maxLength": 5000,
          "description": "保存する食事内容・栄養メモ。overwriteでは空文字を指定して消去できる。"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "対象日（YYYY-MM-DD）。未指定時はtimeZoneId基準の本日。"
        },
        "timeZoneId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "IANAタイムゾーンID。date未指定時の本日判定に使う。"
        },
        "mode": {
          "type": "string",
          "enum": ["append", "overwrite"],
          "description": "既存メモがある場合の保存モード。append または overwrite。"
        }
      },
      "required": ["mealNotes"]
    }
  },
  {
    "name": "save_body_metrics",
    "description": "指定した測定日のDaily記録へ体重、体脂肪率、測定時刻を保存する。既存のDaily項目は保持する。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "bodyWeightKg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 500,
          "multipleOf": 0.01,
          "description": "測定した体重（kg、0より大きく500以下、小数2桁まで）"
        },
        "bodyFatPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.01,
          "description": "測定した体脂肪率（%、0-100、小数2桁まで）"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "測定日（YYYY-MM-DD）"
        },
        "bodyMetricMeasuredTimeLocal": {
          "type": "string",
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
          "description": "測定したローカル時刻（24時間表記HH:mm）"
        },
        "timeZoneId": {
          "type": "string",
          "description": "測定時刻のIANAタイムゾーンID。既定はAsia/Tokyo。"
        }
      },
      "required": ["bodyWeightKg", "bodyFatPercent", "date", "bodyMetricMeasuredTimeLocal"]
    }
  },
  {
    "name": "save_body_metrics_batch",
    "description": "複数日分の体重・体脂肪率を検証または登録する。まずdryRun=trueで確認し、ユーザーの登録指示後にdryRun=falseで実行する。レコード単位で部分成功し、resultsに全行の成功・失敗を返す。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "description": "登録する1-100日分の記録。各要素にはdateと、bodyWeightKgまたはbodyFatPercentの少なくとも一方を指定する。",
          "items": {
            "type": "object",
            "description": "レコード内容はLambdaで個別検証し、不正な要素も他の要素を止めずresultsに失敗として返す。",
            "properties": {
              "date": {
                "type": "string",
                "description": "文字列。測定日（YYYY-MM-DD）。未来日は登録できない。"
              },
              "bodyWeightKg": {
                "type": "number",
                "description": "数値。測定した体重（kg）。0より大きく500以下、小数2桁まで。体脂肪率だけを登録する場合は省略できる。"
              },
              "bodyFatPercent": {
                "type": "number",
                "description": "数値。測定した体脂肪率（%）。0-100、小数2桁まで。体重だけを登録する場合は省略できる。"
              },
              "bodyMetricMeasuredTimeLocal": {
                "type": "string",
                "description": "文字列。測定したローカル時刻（24時間表記HH:mm）。不明な場合は省略する。"
              }
            },
            "additionalProperties": true
          }
        },
        "timeZoneId": {
          "type": "string",
          "description": "全レコードに適用するIANAタイムゾーンID。既定はAsia/Tokyo。"
        },
        "conflictPolicy": {
          "type": "string",
          "enum": ["reject", "overwrite"],
          "description": "既存の異なる値を拒否するreject、または明示同意後に上書きするoverwrite。既定はreject。"
        },
        "dryRun": {
          "type": "boolean",
          "description": "trueは書き込まず検証結果を返す。falseは登録を実行する。"
        }
      },
      "required": ["records", "dryRun"]
    }
  },
  {
    "name": "get_goal",
    "description": "体重・体脂肪率の目標情報を取得する",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "get_ai_character_profile",
    "description": "AIコーチキャラクター設定を取得する",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "get_coaching_context",
    "description": "筋トレ相談の開始時に必ず呼び出し、チャットやAIサービスをまたいで共有する現在の目標・制約・好み・指導方針と、有効な短期引き継ぎメモを取得する。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "有効なメモを判定するユーザーのローカル日付。省略時はtimeZoneIdの現在日。"
        },
        "timeZoneId": {
          "type": "string",
          "description": "IANAタイムゾーンID。既定はAsia/Tokyo。"
        }
      }
    }
  },
  {
    "name": "update_coaching_context",
    "description": "ユーザーが明示的に承認した場合だけ、チャットをまたいで共有する現在の目標・制約・好み・指導方針を新しい版として更新する。更新前にget_coaching_contextで現在のversionを取得する。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "goalSummary": {
          "type": "string",
          "maxLength": 1000,
          "description": "現在の長期・中期目標の簡潔な要約。未設定は空文字。"
        },
        "constraints": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 },
          "description": "怪我、痛み、利用器具、時間などの現在の制約。"
        },
        "preferences": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 },
          "description": "種目、頻度、相談スタイルなどの好み。"
        },
        "trainingPolicy": {
          "type": "string",
          "maxLength": 2000,
          "description": "現在のトレーニング指導方針。未設定は空文字。"
        },
        "nextReviewDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "方針を次に見直すユーザーのローカル日付。"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 0,
          "description": "get_coaching_contextで取得した現在のversion。"
        },
        "source": {
          "type": "string",
          "enum": ["chatgpt", "claude", "kintrain", "user", "other"],
          "description": "更新を提案したAIまたはユーザー。"
        },
        "changeReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "以前の方針から変更する理由。"
        },
        "userConfirmed": {
          "type": "boolean",
          "enum": [true],
          "description": "内容を提示し、ユーザーが保存を明示的に承認した場合だけtrue。"
        }
      },
      "required": [
        "goalSummary",
        "constraints",
        "preferences",
        "trainingPolicy",
        "expectedVersion",
        "source",
        "changeReason",
        "userConfirmed"
      ]
    }
  },
  {
    "name": "append_coaching_note",
    "description": "ユーザーが明示的に承認した重要な観察・判断・次回確認事項・一時的制約だけを、標準90日で自動削除される短期引き継ぎメモとして保存する。恒久情報はupdate_coaching_contextへ統合する。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "同じ保存要求の重複登録を防ぐ一意なキー。"
        },
        "category": {
          "type": "string",
          "enum": ["observation", "decision", "follow-up", "temporary-constraint"],
          "description": "メモの分類。"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "次のチャットへ引き継ぐ簡潔な内容。AI回答全文は保存しない。"
        },
        "validFromDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "メモが有効になるユーザーのローカル日付。"
        },
        "validToDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "メモの有効終了日。"
        },
        "source": {
          "type": "string",
          "enum": ["chatgpt", "claude", "kintrain", "user", "other"],
          "description": "メモを提案したAIまたはユーザー。"
        },
        "userConfirmed": {
          "type": "boolean",
          "enum": [true],
          "description": "内容を提示し、ユーザーが保存を明示的に承認した場合だけtrue。"
        }
      },
      "required": ["idempotencyKey", "category", "content", "source", "userConfirmed"]
    }
  },
  {
    "name": "list_training_menu_items",
    "description": "ユーザーが登録済みのトレーニング種目マスタを一覧取得する。",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "list_training_menu_sets",
    "description": "ユーザーのメニューセットとセット固有の目標値を一覧取得する。",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "get_training_coaching_summary",
    "description": "日常コーチング向けに、指定期間のトレーニング日数、セット数、ストリーク、部位・種目別集計、推定1RM、体組成移動平均、直近コンディションと食事メモを集計して返す。期間は最大366日。",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "集計開始ローカル日（含む）。"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "集計終了ローカル日（含む）。開始日から最大366日。"
        },
        "timeZoneId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "日付境界に使うIANAタイムゾーンID。既定はAsia/Tokyo。"
        }
      },
      "required": ["from", "to"]
    }
  },
  {
    "name": "get_training_plan_for_date",
    "description": "指定日の割り当て済みトレーニング計画を、メニューセット、バージョン、種目名、処方とともに直接取得する。計画がない場合はplan=nullを返す。",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "対象のローカル日付（YYYY-MM-DD）。"
        },
        "timeZoneId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "任意のIANAタイムゾーンID。日付自体は指定値をそのまま使用する。"
        }
      },
      "required": ["date"]
    }
  },
  {
    "name": "reschedule_temporary_training_plan",
    "description": "既存の一時メニューセットID、種目構成、処方を維持したまま有効期間だけを変更する。最初にdryRun=trueで差分を確認する。競合置換にはユーザーの明示確認が必要。",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trainingMenuSetId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "newValidFromDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "newValidToDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "expectedVersion": { "type": "integer", "minimum": 0 },
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 100 },
        "conflictPolicy": {
          "type": "string",
          "enum": ["reject", "replace"],
          "description": "既定はreject。replaceは競合セット全体を安全に置換できる場合だけ許可される。"
