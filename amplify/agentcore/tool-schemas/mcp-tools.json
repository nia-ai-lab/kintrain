[
  {
    "name": "get_gym_visits",
    "description": "ジム実施履歴をローカル日付範囲で取得する。nextTokenがなくなるまで呼び出すと全件取得できる。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "開始ローカル日（YYYY-MM-DD、含む）。未指定なら最古から取得する。"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "終了ローカル日（YYYY-MM-DD、含む）。未指定なら最新まで取得する。"
        },
        "timeZoneId": {
          "type": "string",
          "description": "日付境界に使うIANAタイムゾーンID。既定はAsia/Tokyo。"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "1ページの取得件数（1-100、既定100）"
        },
        "nextToken": {
          "type": "string",
          "description": "前回レスポンスのnextToken。続きがない場合は指定しない。"
        }
      }
    }
  },
  {
    "name": "get_training_history",
    "description": "特定トレーニングメニューの過去実施履歴を取得する",
    "inputSchema": {
      "type": "object",
      "properties": {
        "trainingMenuItemId": {
          "type": "string",
          "description": "対象トレーニングメニューID"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "1ページの取得件数（1-100、既定100）"
        },
        "from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "開始ローカル日（YYYY-MM-DD、含む）。未指定なら最古から取得する。"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "終了ローカル日（YYYY-MM-DD、含む）。未指定なら最新まで取得する。"
        },
        "timeZoneId": {
          "type": "string",
          "description": "日付境界に使うIANAタイムゾーンID。既定はAsia/Tokyo。"
        },
        "nextToken": {
          "type": "string",
          "description": "前回レスポンスのnextToken。続きがない場合は指定しない。"
        }
      },
      "required": ["trainingMenuItemId"]
    }
  },
  {
    "name": "get_daily_records",
    "description": "日付範囲のDaily記録を取得する",
    "inputSchema": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "開始ローカル日（YYYY-MM-DD、含む）。未指定なら最古から取得する。"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "終了ローカル日（YYYY-MM-DD、含む）。未指定なら最新まで取得する。"
        },
        "timeZoneId": {
          "type": "string",
          "description": "日付境界を表すIANAタイムゾーンID。既定はAsia/Tokyo。"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "1ページの取得件数（1-100、既定100）"
        },
        "nextToken": {
          "type": "string",
          "description": "前回レスポンスのnextToken。続きがない場合は指定しない。"
        }
      }
    }
  },
  {
    "name": "get_daily_record",
    "description": "指定日のDaily記録を取得する",
    "inputSchema": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "対象日（YYYY-MM-DD）"
        }
      },
      "required": ["date"]
    }
  },
  {
    "name": "save_daily_diary",
    "description": "Dailyの日記(diary)を保存する。既存日記がある場合はmode指定で追記または上書きする。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "diary": {
          "type": "string",
          "description": "保存する日記本文"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "対象日（YYYY-MM-DD）。未指定時はtimeZoneId基準の本日。"
        },
        "timeZoneId": {
          "type": "string",
          "description": "IANAタイムゾーンID。date未指定時の本日判定に使う。"
        },
        "mode": {
          "type": "string",
          "description": "既存日記がある場合の保存モード。append または overwrite。"
        }
      },
      "required": ["diary"]
    }
  },
  {
    "name": "save_body_metrics",
    "description": "指定した測定日のDaily記録へ体重、体脂肪率、測定時刻を保存する。既存のDaily項目は保持する。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "bodyWeightKg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 500,
          "multipleOf": 0.01,
          "description": "測定した体重（kg、0より大きく500以下、小数2桁まで）"
        },
        "bodyFatPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.01,
          "description": "測定した体脂肪率（%、0-100、小数2桁まで）"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "測定日（YYYY-MM-DD）"
        },
        "bodyMetricMeasuredTimeLocal": {
          "type": "string",
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
          "description": "測定したローカル時刻（24時間表記HH:mm）"
        },
        "timeZoneId": {
          "type": "string",
          "description": "測定時刻のIANAタイムゾーンID。既定はAsia/Tokyo。"
        }
      },
      "required": ["bodyWeightKg", "bodyFatPercent", "date", "bodyMetricMeasuredTimeLocal"]
    }
  },
  {
    "name": "save_body_metrics_batch",
    "description": "複数日分の体重・体脂肪率を検証または登録する。まずdryRun=trueで確認し、ユーザーの登録指示後にdryRun=falseで実行する。レコード単位で部分成功し、resultsに全行の成功・失敗を返す。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "description": "登録する1-100日分の記録。各要素にはdateと、bodyWeightKgまたはbodyFatPercentの少なくとも一方を指定する。",
          "items": {
            "type": "object",
            "description": "レコード内容はLambdaで個別検証し、不正な要素も他の要素を止めずresultsに失敗として返す。",
            "properties": {
              "date": {
                "type": "string",
                "description": "文字列。測定日（YYYY-MM-DD）。未来日は登録できない。"
              },
              "bodyWeightKg": {
                "type": "number",
                "description": "数値。測定した体重（kg）。0より大きく500以下、小数2桁まで。体脂肪率だけを登録する場合は省略できる。"
              },
              "bodyFatPercent": {
                "type": "number",
                "description": "数値。測定した体脂肪率（%）。0-100、小数2桁まで。体重だけを登録する場合は省略できる。"
              },
              "bodyMetricMeasuredTimeLocal": {
                "type": "string",
                "description": "文字列。測定したローカル時刻（24時間表記HH:mm）。不明な場合は省略する。"
              }
            },
            "additionalProperties": true
          }
        },
        "timeZoneId": {
          "type": "string",
          "description": "全レコードに適用するIANAタイムゾーンID。既定はAsia/Tokyo。"
        },
        "conflictPolicy": {
          "type": "string",
          "enum": ["reject", "overwrite"],
          "description": "既存の異なる値を拒否するreject、または明示同意後に上書きするoverwrite。既定はreject。"
        },
        "dryRun": {
          "type": "boolean",
          "description": "trueは書き込まず検証結果を返す。falseは登録を実行する。"
        }
      },
      "required": ["records", "dryRun"]
    }
  },
