  {
    "name": "list_training_menu_items",
    "description": "ユーザーのトレーニング種目マスタを検索・一覧取得する。種目マスタの見直し前に呼び出し、version、利用中セット数、割り当て日への影響を確認する。nextTokenがなくなるまで同じ条件で繰り返す。",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "種目名または説明に含まれる文字列。空白・英字大小を正規化して部分一致検索する。"
        },
        "includeInactive": {
          "type": "boolean",
          "description": "trueならアーカイブ済み種目も含める。既定はfalse。"
        },
        "onlyAiGenerated": {
          "type": "boolean",
          "description": "trueならAIが作成した種目だけを返す。既定はfalse。"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "1ページの取得件数。既定は100。"
        },
        "nextToken": {
          "type": "string",
          "minLength": 1,
          "description": "前回レスポンスのnextToken。検索条件を変えずに使用する。"
        }
      }
    }
  },
  {
    "name": "list_training_menu_sets",
    "description": "ユーザーのメニューセットとセット固有の目標値を一覧取得する。",
